{
  "expo": {
    "name": "DOOEY",
    "slug": "dooey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dooey",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dooey.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.dooey.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6F4EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone so you can ramble.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to use speech recognition so rambles become tasks."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to use your photos so a board or a session can carry one.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera so you can photograph a workout."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
